# ============================================
# Font Configuration
# ============================================
font-family = "MesloLGS Nerd Font Mono"
font-size = 14
font-style = "Bold"

# ============================================
# Window Configuration
# ============================================
# herdr's persisted session is laid out for ~176x48 (26-col sidebar + 150 content).
# Opening smaller forces a full reflow of every pane on attach, then again on resize.
window-width = 180
window-height = 50

# Window padding
window-padding-x = 5
window-padding-y = 5

# Window background opacity
background-opacity = 0.95
background-blur = true

# ============================================
# Theme - Dynamic based on system appearance
# ============================================
theme = dark:"Github Dark",light:"Github Dark"

# ============================================
# Cursor Configuration
# ============================================
cursor-style = block
cursor-style-blink = false

# ============================================
# Scrollback
# ============================================
# Ghostty's default (10MB), per surface. herdr runs full-screen on the alternate
# screen and keeps its own per-pane scrollback, so a larger value here is unused.
scrollback-limit = 10000000

# ============================================
# Tab Bar Configuration
# ============================================
window-decoration = auto
window-theme = auto

# ============================================
# Bell
# ============================================
# Visual bell is enabled by default in Ghostty

# ============================================
# Miscellaneous
# ============================================
confirm-close-surface = false

# ============================================
# Miscellaneous
# ============================================
# Set shell integration features
shell-integration = detect
shell-integration-features = sudo,title,ssh-env,ssh-terminfo
# Set bell features
bell-features = system,audio,attention,title,border
# Set Copy on select
copy-on-select = true
# Set app notifications
app-notifications = config-reload
# Set clipboard access
clipboard-read = allow
clipboard-write = allow
# Active keyboard layout is "ABC", which is not U.S. Standard / U.S. International,
# so Ghostty's layout-dependent default here is false and Option never sends Alt.
# herdr and Claude Code both need Alt for word motions and alt+ bindings.
macos-option-as-alt = true
macos-window-buttons = visible
macos-titlebar-style = native
macos-window-shadow = true
macos-auto-secure-input = true
macos-icon = official
macos-shortcuts = allow
# Enable desktop notifications
desktop-notifications = true
# Set async backend
async-backend = auto
# Set auto-update behavior
auto-update = download
auto-update-channel = stable
